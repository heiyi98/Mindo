# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# fumadocs-mdx generated cache
.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# turbo
.turbo/

# dist
dist/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings (may contain secrets)
.claude/settings.local.json

# apps/web-cn 是独立的git仓库（自己的.git，不带apps/web的提交历史），
# 不属于这个monorepo的版本管理范围
/apps/web-cn/
